# =============================================================================
# Dad Jokes API — Staging Environment Template
# =============================================================================
# WHAT: Environment variables for the "staging" environment, used by
#       docker-compose.staging.yml. Same shape as server/.env.example; see
#       that file for what each variable does.
# WHY:  Staging is meant to look like production, so it needs a real
#       database host and a real admin token, not the shared "postgres"
#       defaults dev uses. No staging host exists yet (no hosting account
#       has been set up), so the values below are placeholders marked
#       REPLACE_ME rather than working credentials. This file stays tracked
#       and safe to commit as long as every REPLACE_ME stays a placeholder;
#       once real values exist, they belong in the hosting platform's
#       secret store, not in this file.
# HOW:  docker-compose.staging.yml loads this via "env_file:".
# =============================================================================

DB_HOST=REPLACE_ME_STAGING_DB_HOST
DB_PORT=5432
DB_USER=REPLACE_ME_STAGING_DB_USER
DB_PASSWORD=REPLACE_ME_STAGING_DB_PASSWORD
DB_NAME=dad_jokes_staging
PORT=3001

# Generate with: openssl rand -hex 32. Never commit the real value here,
# set it as a secret on whichever host runs staging once one is chosen.
ADMIN_TOKEN=REPLACE_ME_STAGING_ADMIN_TOKEN
