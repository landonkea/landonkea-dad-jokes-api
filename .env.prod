# =============================================================================
# Dad Jokes API — Production Environment Template
# =============================================================================
# WHAT: Environment variables for the "prod" environment, used by
#       docker-compose.prod.yml. Same shape as server/.env.example; see that
#       file for what each variable does.
# WHY:  Same reasoning as .env.staging: no production host exists yet, so
#       every value below is a REPLACE_ME placeholder rather than a working
#       credential. This file is tracked so the required shape is visible
#       in version control, real values get set as secrets on whichever
#       host eventually runs production, never committed here.
# HOW:  docker-compose.prod.yml loads this via "env_file:".
# =============================================================================

DB_HOST=REPLACE_ME_PROD_DB_HOST
DB_PORT=5432
DB_USER=REPLACE_ME_PROD_DB_USER
DB_PASSWORD=REPLACE_ME_PROD_DB_PASSWORD
DB_NAME=dad_jokes_prod
PORT=3001

# Generate with: openssl rand -hex 32. Never commit the real value here,
# set it as a secret on whichever host runs production once one is chosen.
ADMIN_TOKEN=REPLACE_ME_PROD_ADMIN_TOKEN
