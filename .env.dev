# =============================================================================
# Dad Jokes API — Dev Environment Template
# =============================================================================
# WHAT: Environment variables for the "dev" environment, used by
#       docker-compose.dev.yml. Same shape as server/.env.example; see that
#       file for what each variable does.
# WHY:  This file is tracked (unlike server/.env, which holds a real local
#       password and is gitignored). Every value below is either a shared
#       local-dev convenience default or a "changeme" placeholder, safe to
#       commit because nothing here is a real secret.
# HOW:  docker-compose.dev.yml loads this via "env_file:". No hosting exists
#       for the dev environment yet, so DB_HOST points at the "db" service
#       docker-compose.dev.yml defines, the same pattern the root
#       docker-compose.yml already uses for local Docker runs.
# =============================================================================

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dad_jokes_dev
PORT=3001

# Dev-only token. Fine to leave as-is since dev never holds real user data,
# but still required, unset ADMIN_TOKEN means admin routes fail closed (503).
ADMIN_TOKEN=dev-changeme
